# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///data/db/attendance.db

# Biometric & Attendance Parameters
FACE_SIMILARITY_THRESHOLD=0.65
MIN_ATTENDANCE_OBSERVATIONS=5
MIN_PRESENCE_RATIO=0.5
LATE_ARRIVAL_MINUTES=10
ENGAGEMENT_WINDOW_SECONDS=30

# Optional Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Privacy
RAW_MEDIA_PERSISTENCE=False
